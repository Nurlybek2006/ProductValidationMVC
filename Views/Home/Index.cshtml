@model ProductValidationMVC.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }
<section class="page-heading"><div><div class="eyebrow"><span class="live-dot"></span> OVERVIEW <span class="eyebrow-divider">/</span> PRODUCT OPERATIONS</div><h1>Welcome back, Nurlibek<span class="heading-dot">.</span></h1><p>Тауарларды басқарыңыз және деректерді бір жерден тексеріңіз.</p></div><a class="btn btn-primary app-button" asp-controller="Products" asp-action="Create"><span>＋</span> Жаңа тауар</a></section>
<section class="stat-grid" aria-label="Негізгі статистика">
 <article class="stat-card"><div class="stat-top"><span>Жалпы тауарлар</span><span class="stat-icon indigo">▦</span></div><strong>@Model.ProductCount</strong><small>Каталогтағы жазба</small><div class="stat-accent indigo-line"></div></article>
 <article class="stat-card"><div class="stat-top"><span>Қойма құны</span><span class="stat-icon cyan">₸</span></div><strong>@Model.InventoryValue.ToString("N0") <em>₸</em></strong><small>Саны × бірлік бағасы</small><div class="stat-accent cyan-line"></div></article>
 <article class="stat-card"><div class="stat-top"><span>Категориялар</span><span class="stat-icon violet">◇</span></div><strong>@Model.CategoryCount</strong><small>Белсенді топтар</small><div class="stat-accent violet-line"></div></article>
 <article class="stat-card"><div class="stat-top"><span>Қоймадағы дана</span><span class="stat-icon green">⌑</span></div><strong>@Model.TotalQuantity</strong><small>Барлық тауар саны</small><div class="stat-accent green-line"></div></article>
</section>
<section class="dashboard-grid">
 <article class="panel recent-panel"><div class="panel-heading"><div><h2>Соңғы тауарлар</h2><p>Каталогқа жуырда қосылғандар</p></div><a class="text-link" asp-controller="Products" asp-action="Index">Барлығын көру <span>→</span></a></div>
 @if (Model.RecentProducts.Count == 0) { <div class="empty-state"><span class="empty-icon">▦</span><h3>Әзірге тауар жоқ</h3><p>Алғашқы тауарды қосып, каталогты бастаңыз.</p><a asp-controller="Products" asp-action="Create" class="btn btn-primary app-button">Тауар қосу <span>→</span></a></div> }
 else { <div class="table-responsive"><table class="table app-table"><thead><tr><th>ТАУАР</th><th>КАТЕГОРИЯ</th><th>БАҒАСЫ</th><th>ҚОСЫЛҒАН КҮНІ</th></tr></thead><tbody>@foreach (var p in Model.RecentProducts) { <tr><td><a class="product-name" asp-controller="Products" asp-action="Details" asp-route-id="@p.Id">@p.Name</a><small class="cell-sub">SKU-@p.Id.ToString("D4")</small></td><td><span class="category-pill">@p.Category</span></td><td class="price-cell">@p.Price.ToString("N2") ₸</td><td class="muted-cell">@p.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</td></tr> }</tbody></table></div> }
 </article>
 <article class="panel category-panel"><div class="panel-heading"><div><h2>Категориялар</h2><p>Қойма құны бойынша</p></div><span class="panel-kicker">TOP 5</span></div>
 @if (Model.Categories.Count == 0) { <div class="mini-empty">Дерек қосылғанда санаттар осы жерде көрсетіледі.</div> } else { var max = Model.Categories.Max(x => x.Value); <div class="category-list">@foreach (var cat in Model.Categories) { var pct = max == 0 ? 0 : (int)Math.Round((double)(cat.Value / max * 100)); <div class="category-row"><div class="category-meta"><span>@cat.Name</span><small>@cat.Count тауар · @cat.Value.ToString("N0") ₸</small></div><div class="progress-track"><span style="width:@pct%"></span></div></div> }</div> }
 </article>
</section>
<section class="bottom-grid"><article class="panel quick-panel"><div class="panel-heading"><div><h2>Жылдам әрекет</h2><p>Жұмысты тез бастаңыз</p></div></div><a class="quick-action" asp-controller="Products" asp-action="Create"><span class="quick-icon">＋</span><span><b>Жаңа тауар қосу</b><small>Каталогқа жаңа жазба енгізу</small></span><span class="quick-arrow">→</span></a><a class="quick-action" asp-controller="Validation" asp-action="Index"><span class="quick-icon cyan">✓</span><span><b>Валидацияны тексеру</b><small>Клиент және сервер тексеруі</small></span><span class="quick-arrow">→</span></a></article>
<article class="panel validation-summary"><div class="panel-heading"><div><h2>Validation жүйесі</h2><p>Деректер сапасын бақылау</p></div><span class="status-badge"><i></i> ACTIVE</span></div><div class="validation-metric"><div class="ring">✓</div><div><b>Үш деңгейлі тексеру</b><small>Data Annotations · ModelState · Custom</small></div></div><p class="validation-copy">Әрбір жаңа тауар браузерде және серверде тексеріледі. Тыйым салынған email мекенжайлары бизнес ережесімен бұғатталады.</p><a class="text-link" asp-controller="Validation" asp-action="Index">Зертханаға өту <span>→</span></a></article></section>
