@model ProductValidationMVC.ViewModels.ProductListViewModel
@{ ViewData["Title"] = "Тауарлар"; }
<section class="page-heading"><div><div class="eyebrow">WORKSPACE <span class="eyebrow-divider">/</span> INVENTORY</div><h1>Тауарлар<span class="heading-dot">.</span></h1><p>Өнім каталогын іздеңіз, сүзгілеңіз және басқарыңыз.</p></div><a class="btn btn-primary app-button" asp-action="Create">＋ Жаңа тауар</a></section>
<section class="panel catalog-panel"><form method="get" class="filter-bar"><div class="search-box"><span>⌕</span><input name="search" value="@Model.Search" placeholder="Тауар атауын іздеу..." aria-label="Тауар атауын іздеу"/></div><select class="form-select filter-select" name="category" aria-label="Категория"><option value="">Барлық категория</option>@foreach (var cat in Model.Categories) { <option value="@cat" selected="@(cat == Model.Category)">@cat</option> }</select><select class="form-select filter-select" name="sort" aria-label="Сұрыптау"><option value="newest" selected="@(Model.Sort == "newest")">Ең жаңасы</option><option value="name" selected="@(Model.Sort == "name")">Атауы бойынша</option><option value="price-asc" selected="@(Model.Sort == "price-asc")">Баға: өсу ретімен</option><option value="price-desc" selected="@(Model.Sort == "price-desc")">Баға: кему ретімен</option></select><button class="btn btn-quiet app-button" type="submit">Сүзу</button></form>
<div class="catalog-info"><span><b>@Model.TotalCount</b> тауар табылды</span><span>Бет @Model.Page / @Math.Max(1, Model.PageCount)</span></div>
@if (Model.Products.Count == 0) { <div class="empty-state catalog-empty"><span class="empty-icon">⌕</span><h3>Тауар табылмады</h3><p>Іздеу шартын өзгертіп көріңіз немесе жаңа тауар қосыңыз.</p><a class="btn btn-primary app-button" asp-action="Create">Жаңа тауар</a></div> }
else { <div class="table-responsive"><table class="table app-table catalog-table"><thead><tr><th>ID</th><th>ТАУАР АТАУЫ</th><th>КАТЕГОРИЯ</th><th>БАҒА</th><th>САНЫ</th><th>ҚОСЫЛҒАН КҮНІ</th><th>ӘРЕКЕТ</th></tr></thead><tbody>@foreach (var p in Model.Products) { <tr><td class="muted-cell">#@p.Id.ToString("D4")</td><td><a class="product-name" asp-action="Details" asp-route-id="@p.Id">@p.Name</a><small class="cell-sub">@(string.IsNullOrWhiteSpace(p.Description) ? "Өнім сипаттамасы жоқ" : p.Description)</small></td><td><span class="category-pill">@p.Category</span></td><td class="price-cell">@p.Price.ToString("N2") ₸</td><td>@p.Quantity</td><td class="muted-cell">@p.CreatedDate.ToLocalTime().ToString("dd MMM yyyy")</td><td><a class="row-action" asp-action="Details" asp-route-id="@p.Id" aria-label="Тауарды көру">↗</a></td></tr> }</tbody></table></div>
<div class="pagination-row"><small>@(((Model.Page - 1) * Model.PageSize) + 1)–@Math.Min(Model.Page * Model.PageSize, Model.TotalCount) / @Model.TotalCount</small><div class="pagination-links">@if (Model.Page > 1) { <a asp-route-page="@(Model.Page-1)" asp-route-search="@Model.Search" asp-route-category="@Model.Category" asp-route-sort="@Model.Sort">← Алдыңғы</a> }@for (var i = 1; i <= Model.PageCount; i++) { <a class="@(i == Model.Page ? "current" : "")" asp-route-page="@i" asp-route-search="@Model.Search" asp-route-category="@Model.Category" asp-route-sort="@Model.Sort">@i</a> }@if (Model.Page < Model.PageCount) { <a asp-route-page="@(Model.Page+1)" asp-route-search="@Model.Search" asp-route-category="@Model.Category" asp-route-sort="@Model.Sort">Келесі →</a> }</div></div> }
</section>
