@model ProductValidationMVC.ViewModels.ProductCreateViewModel
@{ ViewData["Title"] = "Жаңа тауар"; }
<section class="page-heading"><div><div class="eyebrow">CATALOG <span class="eyebrow-divider">/</span> NEW PRODUCT</div><h1>Жаңа тауар қосу<span class="heading-dot">.</span></h1><p>Өнім туралы ақпаратты толтырыңыз. Міндетті өрістер <b>*</b> белгісімен көрсетілген.</p></div><a class="btn btn-quiet app-button" asp-controller="Products" asp-action="Index">← Тізімге оралу</a></section>
<div class="create-layout"><section class="panel form-panel"><div class="form-panel-heading"><div class="form-step">01</div><div><h2>Тауар ақпараты</h2><p>Негізгі сипаттамалар және байланыс деректері</p></div></div>
 <form asp-action="Create" method="post">
  <div asp-validation-summary="All" class="validation-summary-box" role="alert"></div>
  <div class="form-grid"><div class="field full"><label asp-for="Name" class="form-label">Тауар атауы <b>*</b></label><input asp-for="Name" class="form-control" placeholder="Мысалы: MacBook Pro 14" autocomplete="off"/><span asp-validation-for="Name" class="field-error"></span><small class="field-hint">3–100 таңба. Қазақ, орыс және ағылшын әріптері қолдау табады.</small></div>
  <div class="field full"><label asp-for="Description" class="form-label">Сипаттама</label><textarea asp-for="Description" class="form-control" rows="3" placeholder="Тауардың қысқаша сипаттамасы..."></textarea><span asp-validation-for="Description" class="field-error"></span></div>
  <div class="field"><label asp-for="Price" class="form-label">Бағасы <b>*</b></label><div class="input-suffix"><input asp-for="Price" class="form-control" type="number" min="1" max="1000000" step="0.01" placeholder="0.00"/><span>₸</span></div><span asp-validation-for="Price" class="field-error"></span></div>
  <div class="field"><label asp-for="Quantity" class="form-label">Саны <b>*</b></label><input asp-for="Quantity" class="form-control" type="number" min="1" max="10000" placeholder="0"/><span asp-validation-for="Quantity" class="field-error"></span></div>
  <div class="field"><label asp-for="Category" class="form-label">Категория <b>*</b></label><select asp-for="Category" class="form-select"><option value="">Категорияны таңдаңыз</option>@foreach (var cat in new[] { "Электроника", "Жабдықтар", "Кеңсе тауарлары", "Аксессуарлар", "Басқа" }) { <option value="@cat">@cat</option> }</select><span asp-validation-for="Category" class="field-error"></span></div>
  <div class="field"><label asp-for="ManufactureDate" class="form-label">Өндірілген күні <b>*</b></label><input asp-for="ManufactureDate" class="form-control" type="date"/><span asp-validation-for="ManufactureDate" class="field-error"></span></div>
  <div class="field"><label asp-for="Email" class="form-label">Байланыс email <b>*</b></label><input asp-for="Email" class="form-control" type="email" placeholder="name@company.kz" autocomplete="email"/><span asp-validation-for="Email" class="field-error"></span></div>
  <div class="field"><label asp-for="ConfirmEmail" class="form-label">Email растау <b>*</b></label><input asp-for="ConfirmEmail" class="form-control" type="email" placeholder="name@company.kz" autocomplete="off"/><span asp-validation-for="ConfirmEmail" class="field-error"></span></div></div>
  <div class="form-actions"><span class="required-note"><b>*</b> Міндетті өріс</span><div><a asp-controller="Products" asp-action="Index" class="btn btn-quiet app-button">Болдырмау</a><button class="btn btn-primary app-button" type="submit">Тауарды сақтау <span>→</span></button></div></div>
 </form></section>
 <aside class="panel rules-panel"><div class="rules-heading"><span class="rules-icon">⌘</span><div><h2>Validation Rules</h2><p>Енгізу талаптары</p></div></div><div class="rule-list"><div class="rule-item"><span class="rule-check">✓</span><span><b>Тауар атауы</b><small>3–100 таңба · арнайы таңбасыз</small></span></div><div class="rule-item"><span class="rule-check">✓</span><span><b>Бағасы мен саны</b><small>Баға: 1–1 000 000 ₸ · Саны: 1–10 000</small></span></div><div class="rule-item"><span class="rule-check">✓</span><span><b>Email мекенжайы</b><small>Дұрыс пішім және қосымша растау</small></span></div><div class="rule-item"><span class="rule-check">✓</span><span><b>Өндірілген күні</b><small>Болашақ күнді таңдауға болмайды</small></span></div></div><div class="rules-note"><span>ⓘ</span><p>Деректер браузерде және серверде тексеріледі. <code>admin@example.com</code> мекенжайына рұқсат жоқ.</p></div><div class="rules-foot"><span class="live-dot"></span> ASP.NET Core Data Annotations</div></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
