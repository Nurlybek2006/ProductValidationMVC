@model ProductValidationMVC.Models.Product
@{ ViewData["Title"] = "Тауар ақпараты"; }
<section class="page-heading"><div><div class="eyebrow">CATALOG <span class="eyebrow-divider">/</span> PRODUCT DETAILS</div><h1>Тауар ақпараты<span class="heading-dot">.</span></h1><p>SKU-@Model.Id.ToString("D4") · @Model.Category</p></div><a class="btn btn-quiet app-button" asp-action="Index">← Тізімге оралу</a></section>
<section class="panel detail-panel"><div class="detail-title"><span class="detail-product-icon">▦</span><div><h2>@Model.Name</h2><span class="category-pill">@Model.Category</span></div></div><div class="detail-grid"><div><small>БІРЛІК БАҒАСЫ</small><strong>@Model.Price.ToString("N2") ₸</strong></div><div><small>ҚОЙМАДАҒЫ САНЫ</small><strong>@Model.Quantity дана</strong></div><div><small>ЖАЛПЫ ҚҰНЫ</small><strong>@((Model.Price * Model.Quantity).ToString("N2")) ₸</strong></div><div><small>ҚОСЫЛҒАН КҮНІ</small><strong>@Model.CreatedDate.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</strong></div><div><small>БАЙЛАНЫС EMAIL</small><strong>@Model.Email</strong></div></div>@if (!string.IsNullOrWhiteSpace(Model.Description)) { <div class="detail-description"><small>СИПАТТАМА</small><p>@Model.Description</p></div> }</section>
