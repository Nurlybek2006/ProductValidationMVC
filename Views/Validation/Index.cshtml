@model ProductValidationMVC.ViewModels.ValidationDemoViewModel
@{ ViewData["Title"] = "Validation зертханасы"; var submitted = ViewData["Submitted"] as bool? == true; var valid = ViewData["Valid"] as bool? == true; }
<section class="page-heading"><div><div class="eyebrow">DEVELOPER TOOLS <span class="eyebrow-divider">/</span> VALIDATION LAB</div><h1>Validation зертханасы<span class="heading-dot">.</span></h1><p>ASP.NET Core валидациясының клиент және сервер жақтағы жұмысын интерактивті тексеріңіз.</p></div><span class="lab-status"><i></i> INTERACTIVE</span></section>
<section class="lab-intro panel"><div class="lab-orb">✓</div><div><h2>Екі ортақ тексеру қабаты</h2><p>Браузер қолданушыға жылдам жауап береді. Сервер әр сұрауды қайта тексеріп, сенімділікті сақтайды. Клиент тексеруі өшірілгенде де серверлік ережелер жұмысын жалғастырады.</p></div></section>
<section class="lab-grid"><article class="panel annotations-panel"><div class="panel-heading"><div><span class="section-index">01 / RULES</span><h2>Data Annotations</h2><p>ViewModel ішіндегі декларативті ережелер</p></div></div><div class="annotation-list"><div><code>[Required]</code><span>Бос мәндерге жол бермейді</span><small>Атау, email және растау</small></div><div><code>[StringLength]</code><span>Мәтін ұзындығын шектейді</span><small>Атау: 3–40 таңба</small></div><div><code>[Range]</code><span>Санның рұқсат етілген ауқымы</span><small>Баға: 1–1 000 000</small></div><div><code>[EmailAddress]</code><span>Email пішімін тексереді</span><small>name@domain.kz</small></div><div><code>[Compare]</code><span>Екі өрістің бірдейлігін тексереді</span><small>Email және растау</small></div><div><code>[RegularExpression]</code><span>Рұқсат етілген таңбаларды шектейді</span><small>Қазақ, орыс, латын әріптері</small></div></div></article>
<article class="panel demo-panel"><div class="panel-heading"><div><span class="section-index">02 / LIVE DEMO</span><h2>Тексеру формасы</h2><p>Әдейі қате деректер енгізіп көріңіз</p></div></div>
@if (submitted) { <div class="result-banner @(valid ? "is-valid" : "is-invalid")"><span>@(valid ? "✓" : "!")</span><div><b>@(valid ? "Серверлік тексеру сәтті өтті" : "Сервер қателерді тапты")</b><small>@(valid ? "ModelState.IsValid = true — берілген дерек жарамды." : "ModelState.IsValid = false — төмендегі қателер түзетуді қажет етеді.")</small></div></div> }
<form asp-controller="Validation" asp-action="Index" method="post" id="validationDemoForm"><div asp-validation-summary="All" class="validation-summary-box" role="alert"></div><div class="form-grid lab-form-grid"><div class="field"><label asp-for="Name" class="form-label">Тауар атауы</label><input asp-for="Name" class="form-control" placeholder="Үлгі тауар"/><span asp-validation-for="Name" class="field-error"></span></div><div class="field"><label asp-for="Price" class="form-label">Баға</label><div class="input-suffix"><input asp-for="Price" class="form-control" type="number" step="0.01" min="1" max="1000000" placeholder="15000"/><span>₸</span></div><span asp-validation-for="Price" class="field-error"></span></div><div class="field"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" type="email" placeholder="name@example.kz"/><span asp-validation-for="Email" class="field-error"></span></div><div class="field"><label asp-for="ConfirmEmail" class="form-label">Email растау</label><input asp-for="ConfirmEmail" class="form-control" type="email" placeholder="Қайта енгізіңіз"/><span asp-validation-for="ConfirmEmail" class="field-error"></span></div><div class="field full"><label asp-for="Code" class="form-label">Тауар коды <span class="optional-tag">OPTIONAL</span></label><input asp-for="Code" class="form-control" placeholder="KZ Product-01"/><span asp-validation-for="Code" class="field-error"></span></div></div><div class="lab-form-footer"><small>Бұғатталған email: <code>admin@example.com</code></small><button class="btn btn-primary app-button" type="submit">Серверде тексеру <span>→</span></button></div></form>
</article></section>
<section class="lab-bottom-grid"><article class="panel"><div class="panel-heading"><div><span class="section-index">03 / CLIENT SIDE</span><h2>Клиенттік валидация</h2></div><span class="status-badge"><i></i> BROWSER</span></div><p class="lab-body-copy">jQuery Validation және Unobtrusive Validation Razor атрибуттарын браузерде тексереді. Әр өрістегі хабарлама жібермей тұрып жаңарады.</p><div class="code-snippet"><span class="code-label">HTML DATA ATTRIBUTES</span><code>data-val="true"<br/>data-val-required="Атау міндетті."</code></div></article><article class="panel"><div class="panel-heading"><div><span class="section-index">04 / SERVER SIDE</span><h2>Серверлік валидация</h2></div><span class="status-badge"><i></i> MVC</span></div><p class="lab-body-copy">POST әрекеті ModelState нәтижесін оқиды. JavaScript сөндірілсе де, әр сұрау серверде тексеріліп, бизнес ережесі орындалады.</p><div class="code-snippet"><span class="code-label">CONTROLLER ACTION</span><code>if (!ModelState.IsValid)<br/>&nbsp;&nbsp;return View(model);</code></div></article></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
